# Social Poster configuration
# Port for the web UI / API server
PORT=5050

# Where images and the SQLite database are stored. Leave unset in dev (it
# defaults to social-poster/data/); the container image sets it to /data, which
# is a mounted volume.
# DATA_DIR=/data

# Required for Instagram. The Graph API fetches photos from a public URL, so
# this app's /images endpoint must be reachable publicly — point a Cloudflare
# Tunnel at this app and put its https domain here (no trailing slash).
PUBLIC_BASE_URL=https://poster.travisbumgarner.photography

# PUBLIC_BASE_URL is exposed by a named Cloudflare Tunnel (no token needed here),
# run by the Pi's compose stack, not by this app. In dev, `npm run dev` starts an
# ephemeral quick tunnel and injects its URL for you. Bluesky works without any
# of this; only Instagram needs the public URL.

# Dev safety switch. 1 = simulate posting (never send to Instagram/Bluesky),
# 0 = live. Anything other than 1 is treated as live. Set 0 in prod.
# Also suppresses queue notifications (they are logged instead of sent).
DRY_RUN=0

# Queue-depth push notifications. After each publisher run, any account whose
# remaining scheduled posts fall to or below this number gets a "running low"
# message, and a second "queue is empty" one when it hits zero — each sent once
# per drain, re-armed when you queue more. Set 0 to warn only when it's empty.
QUEUE_LOW_THRESHOLD=3

# Set to 1 to turn queue notifications off entirely.
# QUEUE_ALERTS_DISABLED=1

# Notifications go through the same public contact-form relay the portfolio
# sites use — no credentials needed. Only set this if the relay moves.
# CONTACT_FORM_URL=https://contact-form.nfshost.com/contact
